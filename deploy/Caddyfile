{
    servers {
        protocols h1 h2
    }
}

nest.tangsu.me {
    root * /var/www/linknest/current
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        -Server
    }

    @versioned path_regexp versioned ^/assets/[^/]+-[A-Za-z0-9_-]{8,}\.(js|css|woff|woff2)$
    header @versioned Cache-Control "public, max-age=31536000, immutable"

    @documents path / /index.html /404.html /robots.txt /sitemap.xml /CNAME
    header @documents Cache-Control "no-cache"

    file_server

    handle_errors {
        rewrite * /404.html
        file_server
    }
}
